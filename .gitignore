# Generated by xcodegen on every build. Never committed: a pbxproj is the one
# file guaranteed to conflict, and this repo is authored on Windows where it
# cannot even be opened.
*.xcodeproj/
*.xcworkspace/

build/
DerivedData/
.DS_Store

# fastlane leftovers
fastlane/report.xml
fastlane/Preview.html
fastlane/test_output/
fastlane/README.md

# Never, under any circumstances. The App Store Connect key is the whole
# account: with it, anyone can upload builds and change the listing.
*.p8
AuthKey_*
*.mobileprovision
*.cer
*.certSigningRequest
.env
