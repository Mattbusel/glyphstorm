# Anything not expressed as a file in fastlane/metadata lives here.
app_identifier("com.mattbusel.asciimotion")

# Paid app. The tier is set on the app record; this asserts it is not free so a
# mistake in Connect shows up as a mismatch rather than as a free launch.
price_tier(8)

