# Anything not expressed as a file in fastlane/metadata lives here.
app_identifier("com.mattbusel.asciimotion")

# No price_tier here, deliberately.
#
# It makes deliver PATCH the app with `availableInNewTerritories`, `prices` and
# `availableTerritories`, none of which are attributes of `apps` any more. Apple
# rejects the whole request and the upload dies after the binary has already
# been built and signed.
#
# Pricing is set through the modern appPriceSchedules API instead, by
# Store/listing.py, and is already live at $7.99.

# Filled from fastlane/metadata/en-US/*.txt automatically. Listed here so it is
# obvious what is being uploaded.
copyright("#{Time.now.year} Matthew Busel")

submission_information({
  add_id_info_uses_idfa: false,
  export_compliance_uses_encryption: false,
  content_rights_contains_third_party_content: false
})
